ARG FROM_BUILDER_VERSION=latest

FROM sth-builder:${FROM_BUILDER_VERSION} AS builder

FROM node:22-bookworm-slim AS target

ARG USER=sth

RUN groupadd -g 998 ${USER} \
    && useradd -g 998 -u 998 -m -d /opt/${USER} -s /bin/false ${USER}

WORKDIR /dist

COPY --from=builder /build/dist/cli                      ./cli
COPY --from=builder /build/dist/api-client               ./api-client
COPY --from=builder /build/dist/client-utils             ./client-utils
COPY --from=builder /build/dist/middleware-api-client    ./middleware-api-client
COPY --from=builder /build/dist/obj-logger               ./obj-logger
COPY --from=builder /build/dist/utility                  ./utility
COPY --from=builder /build/dist/types                    ./types
COPY --from=builder /build/dist/symbols                  ./symbols
COPY --from=builder /build/dist/model                    ./model
COPY --from=builder /build/dist/multi-manager-api-client ./multi-manager-api-client

COPY --from=builder /build/dist/package.json ./package.json
COPY --from=builder /build/dist/package-lock.json ./package-lock.json

RUN npm install -ws --omit=dev

WORKDIR /opt/${USER}

USER ${USER}

RUN node /dist/cli --version

ENTRYPOINT [ "node", "/dist/cli" ]
