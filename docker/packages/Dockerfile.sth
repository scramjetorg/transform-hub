ARG FROM_BUILDER_VERSION=latest

FROM sth-builder:${FROM_BUILDER_VERSION} AS builder

FROM node:22-bookworm-slim AS target

ARG USER=sth

RUN groupadd -g 998 ${USER} \
    && useradd -g 998 -u 998 -m -d /opt/${USER} -s /bin/false ${USER}

WORKDIR /dist
COPY --from=builder /build/dist/sth                 ./sth
COPY --from=builder /build/dist/host                ./host
COPY --from=builder /build/dist/obj-logger          ./obj-logger
COPY --from=builder /build/dist/utility             ./utility
COPY --from=builder /build/dist/adapters            ./adapters
COPY --from=builder /build/dist/model               ./model
COPY --from=builder /build/dist/types               ./types
COPY --from=builder /build/dist/api-server          ./api-server
COPY --from=builder /build/dist/load-check          ./load-check
COPY --from=builder /build/dist/monitoring-server   ./monitoring-server
COPY --from=builder /build/dist/symbols             ./symbols
COPY --from=builder /build/dist/telemetry           ./telemetry
COPY --from=builder /build/dist/verser              ./verser
COPY --from=builder /build/dist/bpmux               ./bpmux
COPY --from=builder /build/dist/adapter-docker      ./adapter-docker
COPY --from=builder /build/dist/adapter-kubernetes  ./adapter-kubernetes
COPY --from=builder /build/dist/adapter-process     ./adapter-process
COPY --from=builder /build/dist/frame-stream        ./frame-stream
COPY --from=builder /build/dist/adapters-common     ./adapters-common
COPY --from=builder /build/dist/pre-runner          ./pre-runner
COPY --from=builder /build/dist/runner              ./runner
COPY --from=builder /build/dist/python-runner       ./python-runner
COPY --from=builder /build/dist/module-loader       ./module-loader
COPY --from=builder /build/dist/api-client          ./api-client
COPY --from=builder /build/dist/client-utils        ./client-utils

COPY --from=builder /build/dist/package.json ./package.json
COPY --from=builder /build/dist/package-lock.json ./package-lock.json

RUN npm install -ws --omit=dev

WORKDIR /opt/${USER}

USER ${USER}

RUN node /dist/sth --version

ENTRYPOINT [ "node", "/dist/sth" ]
