FROM node:22-bookworm-slim

ENV BUN_INSTALL=/opt/bun
ARG CHECKPOINT_RUNTIME_DEPENDENCIES=false
COPY runtime-dependencies/ /opt/transform-hub/runtime-dependencies/
COPY scripts/checkpoint/verify-runtime-dependencies.js /usr/local/bin/verify-runtime-dependencies.js

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl procps unzip python3 \
    && if [ "${CHECKPOINT_RUNTIME_DEPENDENCIES}" = "true" ]; then \
        node /usr/local/bin/verify-runtime-dependencies.js "/opt/transform-hub/runtime-dependencies" \
        && \
        unzip -q /opt/transform-hub/runtime-dependencies/bun/bun-linux-x64.zip -d /opt/bun \
        && ln -s /opt/bun/bun-linux-x64/bun /usr/local/bin/bun \
        && ln -s /opt/bun/bun-linux-x64/bunx /usr/local/bin/bunx; \
    else curl -fsSL https://bun.sh/install | bash \
        && ln -s /opt/bun/bin/bun /usr/local/bin/bun \
        && ln -s /opt/bun/bin/bunx /usr/local/bin/bunx; fi \
    && chmod -R a+rX /opt/bun \
    && rm -rf /var/lib/apt/lists/*

ENV PATH="/opt/bun/bin:${PATH}"
