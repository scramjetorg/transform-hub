{
  "name": "scramjet-bdd",
  "version": "1.1.0",
  "description": "As the \"problem scope\" of the business problem that our technology solves is quite complex, we decided to use the BDD practice to support the development process. BDD is a methodology of high automation and agility. It describes a cycle of interactions with well-defined outcomes. As a result of these activities, we obtain working, tested software that has a real value.",
  "main": "_cucumber.js",
  "dependencies": {
    "@scramjet/api-client": "^1.1.0",
    "@scramjet/api-types": "^1.1.0",
    "@scramjet/client-utils": "^1.1.0",
    "@scramjet/logger": "^1.1.0",
    "@scramjet/multi-manager-api-client": "^1.1.0",
    "@scramjet/obj-logger": "^1.1.0",
    "@scramjet/sequence-types": "^1.1.0",
    "@scramjet/config": "^1.1.0",
    "@scramjet/utility": "^1.1.0",
    "@signicode/verser2-guest-node": "0.7.0",
    "@signicode/verser2-host": "0.7.0",
    "dockerode": "^3.3.4",
    "find-package-json": "^1.2.0",
    "freeport": "^1.0.5",
    "glob": "^7.2.3",
    "n-readlines": "^1.0.1",
    "scramjet": "^4.37.0"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^7.3.2",
    "@cucumber/messages": "^14.0.0",
    "@cucumber/pretty-formatter": "^1.0.0"
