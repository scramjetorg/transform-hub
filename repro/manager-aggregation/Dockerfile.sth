# STH hub repro image — uses pre-built dist/ artifacts from the monorepo.
# Build from sth/:
#   docker build -t repro-sth -f repro/manager-aggregation/Dockerfile.sth .

FROM node:20-bookworm-slim AS builder

WORKDIR /build
COPY dist/ ./dist/

WORKDIR /build/dist
RUN npm install --omit=dev --no-audit --no-fund 2>&1

FROM node:20-bookworm-slim

RUN groupadd -g 998 sth && useradd -g 998 -u 998 -m -d /opt/sth -s /bin/false sth

WORKDIR /dist
COPY --from=builder /build/dist/ ./dist/

# Copy entry helper
COPY repro/manager-aggregation/scripts/wait-for-it.sh /usr/local/bin/wait-for-it.sh
COPY repro/manager-aggregation/sequences /sequences
COPY repro/manager-aggregation/startup /startup
RUN chmod +x /usr/local/bin/wait-for-it.sh

WORKDIR /dist/dist

USER sth

ENTRYPOINT ["node", "sth/bin/hub.js"]
