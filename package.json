{
  "name": "@scramjet/transform-hub",
  "version": "2.0.0",
  "private": true,
  "description": "A development repo for Scramjet Transform Hub, a container supervisor that allows deployment, execution and monitoring of any application based on a simple interface.",
  "main": "index.js",
  "bin": {
    "scramjet-transform-hub": "dist/sth/bin/hub.js"
  },
  "scripts": {
    "build": "npm run build:all",
    "build:all": "npm run build:packages && npm run build:docker",
    "build:all-packages": "npm run build:packages",
    "prebuild:packages": "scripts/run-script.js -v -w packages build:only",
    "build:packages": "scripts/build-all.js -v -w packages --ts-config tsconfig.build.json && node scripts/check-runner-python-build-artifact.js",
    "build:docker": "scripts/run-script.js -w packages build:docker",
    "build:docker:runners": "scripts/run-script.js -w runners build:docker",
    "docs:clean": "node ./scripts/docs.js clean",
    "docs:generate": "node ./scripts/docs.js generate",
    "docs:generate:content": "node ./scripts/docs.js generate:content",
    "docs:generate:reference": "node ./scripts/docs.js generate:reference",
    "docs:generate:readmes": "node ./scripts/docs.js generate:readmes",
    "docs:generate:api": "node ./scripts/docs.js generate:api",
    "docs:check": "node ./scripts/docs.js check",
    "build:runner-images": "scripts/run-script.js -v -w packages export:docker",
    "prepack:pub": "scripts/run-script.js -w release build:only",
    "pack:pub": "npm run clean:root && FLAT_PACKAGES=true MAKE_PUBLIC=true NO_INSTALL=true scripts/build-all.js -w release --ts-config tsconfig.build.json",
    "publish:dist": "./scripts/publish-order-dist-packages.js -s -p --release-boundary",
    "cloc": "cloc . --fullpath --include-lang TypeScript,JavaScript,Python,Dockerfile,Markdown  --match-d=\"(packages|bdd/step-definitions|bdd/lib)\" --not-match-d \"(node_modules|test|dist)\" --by-percent cmb",
    "clean": "npm run clean:root && scripts/run-script.js clean",
    "clean:root": "rm -rf ./dist/",
    "clean:modules": "find -name node_modules -or -name __pypackages__ -prune -exec rm -rf {} ';' 2> /dev/null",
    "lint": "RAYON_NUM_THREADS=12 biome lint --error-on-warnings .",
    "lint:fix": "RAYON_NUM_THREADS=12 biome lint --write --error-on-warnings .",
    "lint:full": "RAYON_NUM_THREADS=12 biome lint --error-on-warnings .",
    "lint:quick": "RAYON_NUM_THREADS=12 biome lint --changed --error-on-warnings",
    "lint:staged": "RAYON_NUM_THREADS=12 biome lint --staged --error-on-warnings",
    "typecheck": "node scripts/typecheck.js",
    "format": "RAYON_NUM_THREADS=12 biome format --write .",
    "format:check": "RAYON_NUM_THREADS=12 biome format .",
    "biome:check": "RAYON_NUM_THREADS=12 biome lint --error-on-warnings .",
    "biome:format": "RAYON_NUM_THREADS=12 biome format .",
    "biome:lint": "RAYON_NUM_THREADS=12 biome lint --error-on-warnings .",
    "check:runtime-invariants": "bash scripts/check-runtime-wrapper-invariants.sh",
    "check:licenses": "node scripts/release-align.js check",
    "check:security-workflow": "node scripts/check-workflow-policy.js --file .github/workflows/security-check.yml",
    "check:workflow-policy": "node scripts/check-workflow-policy.js --file scripts/test/fixtures/workflow-policy/compliant.yml",
    "check:ava-memory-guard-adoption": "node scripts/check-ava-memory-guard-adoption.js",
    "check:typings-split": "bash scripts/check-typings-split-boundaries.sh && node node_modules/typescript/bin/tsc -p packages/types/test-typings-split/tsconfig.json --noEmit",
    "test:runner": "ulimit -v 1835008 2>/dev/null && SCRAMJET_AVA_NO_WORKER_THREADS=1 node scripts/run-ava.js scripts/test/*.spec.js --serial",
    "test:security-hooks": "node scripts/run-ava.js scripts/test/security-hooks.spec.js",
    "test:security-ci": "node scripts/run-ava.js scripts/test/security-hooks.spec.js scripts/test/security-ci-workflow.spec.js",
    "test:checkpoint": "node scripts/run-ava.js scripts/test/checkpoint-provenance.spec.js scripts/test/checkpoint-workflow.spec.js",
    "test:workflow-policy": "node scripts/run-ava.js scripts/test/workflow-policy.spec.js",
    "test:memory-guard-ava": "ulimit -v 1835008 2>/dev/null && NODE_OPTIONS=\"--max-old-space-size=1024\" SCRAMJET_AVA_MEMORY_GUARD=1 node scripts/run-ava.js scripts/test/ava-memory-guard-live.spec.js",
    "test:memory-guard-bdd-focused": "ulimit -v 1835008 2>/dev/null && NODE_OPTIONS=\"--max-old-space-size=1024\" SCRAMJET_AVA_NO_WORKER_THREADS=1 node scripts/run-ava.js scripts/test/bdd-options.spec.js scripts/test/bdd-memory-guard.spec.js scripts/test/run-bdd.spec.js scripts/test/bdd-memory-registry.spec.js --serial",
    "test:memory-guard-sequence-test": "cd packages/sequence-test && ulimit -v 1835008 2>/dev/null && NODE_OPTIONS=\"--max-old-space-size=1024\" SCRAMJET_AVA_MEMORY_GUARD=1 node ../../scripts/run-ava.js test/harness/captures.spec.ts test/harness/index.spec.ts",
    "test:sequence-appcontext": "cd packages/sequence-test && ulimit -v 1835008 2>/dev/null && node ../../scripts/run-ava.js test/harness/sequence-types-api.spec.ts",
    "pack:appcontext-fixtures": "node scripts/pack-appcontext-fixtures.js",
    "pack:bdd-fixtures": "node scripts/pack-bdd-fixtures.js",
    "pack:python-bdd-fixtures": "node scripts/pack-python-bdd-fixtures.js",
    "test:bdd-appcontext": "SCRAMJET_SPAWN_TS=1 RUNTIME_ADAPTER=process node scripts/run-bdd.js -- features/appcontext/APPCONTEXT-001-full-sequence.feature --tags \"@ci-appcontext and not @ignore\" --exit --format pretty",
    "check:typings-split:boundaries": "bash scripts/check-typings-split-boundaries.sh",
    "check:typings-split:types": "node node_modules/typescript/bin/tsc -p packages/types/test-typings-split/tsconfig.json --noEmit",
    "check:verser2-packages": "node scripts/check-verser2-github-packages.js",
    "release:align:check": "node scripts/release-align.js check",
    "release:align:dry-run": "node scripts/release-align.js dry-run",
    "release:align:apply": "node scripts/release-align.js apply",
    "release:align:apply-licenses": "node scripts/release-align.js apply-licenses",
    "start": "DEVELOPMENT=true node dist/sth/bin/hub.js",
    "start:dev": "tsx packages/sth/src/bin/hub.ts",
    "start:dev:cli": "DEVELOPMENT=true tsx packages/cli/src/bin/index.ts",
    "install:clean": "npm run clean && npm run clean:modules && npm install",
    "hooks:install": "node scripts/security/install-hooks.js",
    "security:bootstrap": "node scripts/security/bootstrap-gitleaks.js",
    "security:scan-history": "node scripts/security/scan-git-history.js",
    "postinstall": "scripts/run-script.js -v -w packages install:deps",
    "test": "npm run test:packages",
    "test:packages": "scripts/run-script.js -w packages test",
    "test:packages:fast": "SCRAMJET_TEST_PROFILE=fast scripts/run-script.js -w packages -j 16 test",
    "test:packages:phase-final": "SCRAMJET_TEST_PROFILE=phase-final scripts/run-script.js -w packages -j 1 test",
    "test:packages-no-concurrent": "scripts/run-script.js -w packages -j 1 test",
    "test:bdd-ci-hub": "NO_HOST=true node scripts/run-bdd-docker.js -- --format=pretty -t \"@ci-hub and not @requires-docker and not @docker-specific and not @slow and not @stress and not @perf and not @load and not @external-dependency and not @compatibility\"",
    "test:bdd-ci-hub-docker": "NO_HOST=true RUNTIME_ADAPTER=docker node scripts/run-bdd-docker.js -- --format=pretty -t \"@ci-hub and @requires-docker and not @slow and not @stress and not @perf and not @load and not @external-dependency and not @compatibility\"",
    "test:bdd-manager-migration": "BDD_INCLUDE_LONG_RUNNING=1 node scripts/run-bdd.js -- --format=pretty -t \"@manager-migration and not @ignore and not @slow and not @stress and not @perf and not @load and not @external-dependency and not @compatibility\"",
    "test:bdd-ci-api": "npm run test:bdd-ci-api-node",
    "test:bdd-ci-api-node": "node scripts/run-bdd-docker.js -- --format=pretty -t \"@ci-api and not @slow and not @stress and not @perf and not @load and not @external-dependency and not @compatibility and not @needs-fix\"",
    "test:bdd-ci-api-topic": "node scripts/run-bdd-docker.js -- --format=pretty -t \"@ci-topic and not @slow and not @stress and not @perf and not @load and not @external-dependency and not @compatibility\"",
    "test:bdd-ci-verser2": "NO_HOST=true node scripts/run-bdd.js -- --format=pretty -t \"@ci-verser2 and not @ignore\"",
    "test:bdd-ci-python": "node scripts/run-bdd-docker.js -- --format=pretty -t \"@ci-instance-python and not @slow and not @stress and not @perf and not @load and not @external-dependency and not @compatibility\"",
    "test:bdd-ci-node": "node scripts/run-bdd-docker.js -- --format=pretty -t \"@ci-instance-node and not @requires-bun and not @slow and not @stress and not @perf and not @load and not @external-dependency and not @compatibility\"",
    "test:bdd-ci-bun": "BDD_NODE_IMAGE=transform-hub-bdd-bun:dev node scripts/run-bdd-docker.js -- --format=pretty -t \"@requires-bun and not @slow and not @stress and not @perf and not @load and not @external-dependency and not @compatibility\"",
    "test:bdd-long": "npm run pack:python-bdd-fixtures && BDD_INCLUDE_LONG_RUNNING=1 node scripts/run-bdd-docker.js -- --fail-fast -t \"@slow or @stress or @perf or @load or @external-dependency or @compatibility or @manager-migration or @requires-docker or @docker-specific\"",
    "test:bdd": "BDD_INCLUDE_LONG_RUNNING=1 node scripts/run-bdd-modes.js --mode=base -- --fail-fast",
    "test:bdd-extra": "BDD_INCLUDE_LONG_RUNNING=1 node scripts/run-bdd-modes.js --mode=extra -- --fail-fast",
    "test:bdd:ts": "SCRAMJET_SPAWN_TS=1 PACKAGES_DIR=\"data/sequences/appcontext-packages/:data/sequences/python-bdd-packages/\" node scripts/run-bdd-docker.js -- --fail-fast",
    "test:bdd-waves": "node scripts/run-bdd-waves.js",
    "test:unified-py": "npm run pack:python-bdd-fixtures && PACKAGES_DIR=\"data/sequences/python-bdd-packages/\" node scripts/run-bdd-docker.js -- --format=pretty -t @ci-unified",
    "test:unified-js": "PACKAGES_DIR=../packages/ node scripts/run-bdd-docker.js -- --format=pretty -t @ci-unified",
    "test:coverage": "nyc npm run test:bdd",
    "prebump:packages": "NEXT_VER=$(npx semver -i ${VERSION_LEVEL:-prerelease} $(jq -r .version < package.json)) && git diff --exit-code --quiet && npm run bump:images && ./scripts/add-to-packages-json.js --pattern={bdd/,packages/**/}package.json -o version \"${NEXT_VER}\" && bash ./scripts/bump-dependencies-versions.sh \"${NEXT_VER}\" && git add .",
    "bump:packages": "NEXT_VER=$(npx semver -i ${VERSION_LEVEL:-prerelease} $(jq -r .version < package.json)) && npm version ${NEXT_VER}",
    "bump:images": "./scripts/bump_docker_images.sh",
    "bump:version:minor": "VERSION_LEVEL=minor npm run bump:packages",
    "bump:version:patch": "VERSION_LEVEL=patch npm run bump:packages",
    "bump:version:major": "VERSION_LEVEL=major npm run bump:packages",
    "bump:version": "npm run bump:packages -- --no-git-tag-version",
    "bump:postversion": "npm run pack:pub && npm run publish:dist && git push --follow-tags",
    "upgrade:all": "scripts/deps-update.js -f && npm install",
    "savehash": "scripts/run-script.js -w packages savehash",
    "docs:sync:readmes": "node ./scripts/docs.js sync:readmes"
  },
  "author": "Scramjet <open-source@scramjet.org>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/scramjetorg/transform-hub.git"
  },
  "scramjet": {
    "docs": {
      "outputDir": "docs"
    }
  },
  "devDependencies": {
    "@ava/typescript": "^7.0.0",
    "@biomejs/biome": "2.5.0",
    "@cucumber/cucumber": "^13.0.0",
    "@cucumber/messages": "^34.0.0",
    "@istanbuljs/nyc-config-typescript": "^1.0.2",
    "@npmcli/run-script": "^11.0.0",
    "@types/node": "^22.15.0",
    "@vscode/ripgrep": "^1.18.0",
    "ava": "^8.0.0",
    "cloc": "^2.11.0",
    "fs-extra": "^9.1.0",
    "glob": "^7.2.3",
    "globrex": "^0.1.2",
    "minimist": "^1.2.8",
    "npm": "11.19.0",
    "nyc": "^18.0.0",
    "scramjet-bdd": "file:bdd",
    "semver": "^7.7.1",
    "tar": "^7.5.21",
    "toposort": "^2.0.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.3",
    "typescript": "~4.7.4"
  },
  "workspaces": {
    "packages": [
      "packages/adapter-docker",
      "packages/adapter-kubernetes",
      "packages/adapter-process",
      "packages/adapters",
      "packages/adapters-common",
      "packages/api-client",
      "packages/api-router",
      "packages/api-server",
      "packages/api-types",
      "packages/cli",
      "packages/client-utils",
      "packages/config",
      "packages/host",
      "packages/load-check",
      "packages/logger",
      "packages/manager",
      "packages/middleware-api-client",
      "packages/model",
      "packages/module-loader",
      "packages/monitoring-server",
      "packages/multi-manager",
      "packages/multi-manager-api-client",
      "packages/obj-logger",
      "packages/pre-runner",
      "packages/rest-api2",
      "packages/runner",
      "packages/runner-bun",
      "packages/runner-node",
      "packages/runner-python",
      "packages/runtime-types",
      "packages/sequence-test",
      "packages/sequence-types",
      "packages/sth",
      "packages/symbols",
      "packages/telemetry",
      "packages/types",
      "packages/utility"
    ],
    "release": [
      "packages/adapter-docker",
      "packages/adapter-kubernetes",
      "packages/adapter-process",
      "packages/adapters",
      "packages/adapters-common",
      "packages/api-client",
      "packages/api-router",
      "packages/api-server",
      "packages/api-types",
      "packages/cli",
      "packages/client-utils",
      "packages/config",
      "packages/host",
      "packages/load-check",
      "packages/logger",
      "packages/manager",
      "packages/middleware-api-client",
      "packages/model",
      "packages/module-loader",
      "packages/monitoring-server",
      "packages/multi-manager",
      "packages/multi-manager-api-client",
      "packages/obj-logger",
      "packages/pre-runner",
      "packages/rest-api2",
      "packages/runner",
      "packages/runner-bun",
      "packages/runner-node",
      "packages/runner-python",
      "packages/runtime-types",
      "packages/sequence-test",
      "packages/sequence-types",
      "packages/sth",
      "packages/symbols",
      "packages/telemetry",
      "packages/types",
      "packages/utility"
    ],
    "runners": [
      "packages/runner",
      "packages/runner-bun",
      "packages/python-runner",
      "packages/pre-runner"
    ],
    "bdd": [
      "bdd/"
    ]
  },
  "ava": {
    "files": [
      "scripts/test/*.spec.js"
    ],
    "serial": true
  },
  "husky": {
    "hooks": {
      "pre-push": "npm run lint"
    }
  },
  "dependencies": {
    "scramjet": "^4.37.0"
  }
}
