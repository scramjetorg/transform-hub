{
  "$schema": "https://opencode.ai/config.json",
  "lsp": {
    "eslint": { "disabled": true },
    "biome": {
      "command": ["npx", "biome", "lsp-proxy"],
      "extensions": ["js", "jsx", "ts", "tsx", "json", "jsonc"]
    }
  },
  "plugin": ["file:///home/michal/_oc-plugins/oh-my-opencode-slim/index.js", "file:///home/michal/_oc-plugins/opencode-conductor/index.js"],
  "permission": {
    "bash": "allow",
    "edit": "allow",
    "write": "allow",
    "read": "allow",
    "grep": "allow",
    "list": "allow",
    "patch": "allow",
    "skill": "allow",
    "task": "allow",
    "todowrite": "allow",
    "todoread": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "question": "allow"
  }
}
