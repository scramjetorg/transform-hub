{
  "name": "@scramjet/rest-api2",
  "version": "2.0.0",
  "description": "Scramjet Transform Hub v2 REST API contracts and common client.",
  "main": "./src/index.ts",
  "scripts": {
    "start": "ts-node ./src/index",
    "build": "../../scripts/build-all.js --config-name=tsconfig.build.json --copy-dist",
    "clean": "rm -rf ./dist .bic_cache",
    "test": "npm run test:ava",
    "test:ava": "node ../../scripts/run-ava.js -T 50000 --serial"
  },
  "author": "Scramjet <open-source@scramjet.org>",
  "license": "MIT",
  "dependencies": {
    "@scramjet/api-router": "^2.0.0",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@ava/typescript": "^7.0.0",
    "@types/node": "^22.15.0",
    "ava": "^8.0.0",
    "ts-node": "^10.9.1",
    "typescript": "~4.7.4"
  },
  "ava": {
    "files": [
      "test/**/*.spec.ts"
    ],
    "require": [
      "ts-node/register"
    ],
    "typescript": {
      "compile": false,
      "rewritePaths": {
        "./": "../.ava-rest-api2/"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/scramjetorg/transform-hub.git"
  }
}
