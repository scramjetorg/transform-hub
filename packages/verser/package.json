{
  "name": "@scramjet/verser",
  "version": "1.1.0",
  "description": "This package is part of Scramjet Transform Hub. The package provides a reverse server functionality used among Scramjet modules.",
  "main": "./src/index.ts",
  "scripts": {
    "build": "../../scripts/build-all.js --config-name=tsconfig.build.json --copy-dist",
    "clean": "rm -rf ./dist .bic_cache",
    "test": "npm run test:ava",
    "test:ava": "node ../../scripts/run-ava.js",
    "test:legacy": "node ../../scripts/run-ava.js test/http-connection.spec.ts"
  },
  "author": "Scramjet <open-source@scramjet.org>",
  "license": "AGPL-3.0",
  "dependencies": {
    "@scramjet/obj-logger": "^2.0.0",
    "@scramjet/utility": "^2.0.0",
    "@scramjet/bpmux": "^9.0.0"
  },
  "devDependencies": {
    "@ava/typescript": "^7.0.0",
    "@scramjet/api-server": "^2.0.0",
    "@scramjet/api-types": "^2.0.0",
    "@scramjet/runtime-types": "^2.0.0",
    "@scramjet/types": "^2.0.0",
    "@types/node": "^22.15.0",
    "ava": "^8.0.0",
    "ts-node": "^10.9.1",
    "typescript": "~4.7.4"
  },
  "ava": {
    "files": [
      "test/exports.spec.ts"
    ],
    "require": [
      "ts-node/register"
    ],
    "typescript": {
      "compile": false,
      "rewritePaths": {
        "./": "../.ava-verser/"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/scramjetorg/transform-hub.git"
  }
}
