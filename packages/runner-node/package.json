{
  "name": "@scramjet/runner-node",
  "version": "2.3.2",
  "description": "Node sequence runtime for Scramjet Transform Hub runner isolation.",
  "main": "./src/index.ts",
  "bin": {
    "runner-node": "./src/bin/runner-node.ts"
  },
  "scripts": {
    "build": "../../scripts/build-all.js --config-name=tsconfig.build.json --copy-dist",
    "clean": "rm -rf ./dist .bic_cache",
    "test": "SCRAMJET_AVA_TYPECHECK=0 SCRAMJET_AVA_MAX_OLD_SPACE_SIZE=1024 SCRAMJET_AVA_FETCH=0 node ../../scripts/run-ava.js -T 120000"
  },
  "author": "Scramjet <opensource@scramjet.org>",
  "license": "MIT",
  "dependencies": {
    "@scramjet/api-client": "^2.3.2",
    "@scramjet/api-router": "^2.3.2",
    "@scramjet/api-server": "^2.3.2",
    "@scramjet/api-types": "^2.3.2",
    "@scramjet/client-utils": "^2.3.2",
    "@scramjet/model": "^2.3.2",
    "@scramjet/obj-logger": "^2.3.2",
    "@scramjet/rest-api2": "^2.3.2",
    "@scramjet/runtime-types": "^2.3.2",
    "@scramjet/symbols": "^2.3.2",
    "@scramjet/utility": "^2.3.2",
    "@signicode/verser2-guest-node": "0.9.3",
    "scramjet": "^4.37.0"
  },
  "devDependencies": {
    "@ava/typescript": "^7.0.0",
    "@scramjet/types": "^2.3.2",
    "@types/node": "^22.15.0",
    "ava": "^8.0.0",
    "typescript": "5.9.3",
    "tsx": "^4.23.15"
  },
  "ava": {
    "files": [
      "**/*.spec.ts"
    ],
    "require": [
      "../../scripts/lib/tsx-cjs-register.cjs"
    ],
    "typescript": {
      "compile": false,
      "rewritePaths": {
        "./": "../.ava-runner-node/"
      }
    }
  },
  "files": [
    "**/*.js",
    "**/*.d.ts",
    "**/*.json",
    "!src/**",
    "!test/**",
    "!tests/**",
    "!**/*.map",
    "!**/*.tsbuildinfo"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/scramjetorg/transform-hub.git",
    "directory": "packages/runner-node"
  }
}
