{
  "name": "@scramjet/manager-config",
  "version": "0.35.1",
  "description": "Scramjet CPM Config",
  "main": "src/index.ts",
  "scripts": {
    "build": "../../scripts/build-all.js --config-name=tsconfig.build.json --copy-dist",
    "build:docs": "node -e \"console.log('Package TypeDoc generation retired; run npm run docs:generate from the repository root.')\"",
    "clean": "rm -rf ./dist .bic_cache",
    "watch": "tsc -b --watch",
    "test": "echo no tests yet -- # npm run test:ava",
    "test:ava": "node ../../scripts/run-ava.js"
  },
  "dependencies": {
    "@scramjet/api-types": "^1.1.0",
    "@scramjet/utility": "^1.1.0"
  },
  "devDependencies": {
    "@scramjet/runtime-types": "^1.1.0",
    "@scramjet/types": "^1.1.0",
    "ava": "^3.15.0",
    "typedoc": "^0.22.18",
    "typedoc-plugin-markdown": "^3.13.4"
  },
  "ava": {
    "extensions": [
      "ts"
    ],
    "files": [
      "**/*.spec.ts"
    ],
    "require": [
      "ts-node/register"
    ]
  },
  "author": "Scramjet <open-source@scramjet.org>",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/scramjetorg/scramjet-cpm-dev.git"
  }
}
