{
  "name": "@scramjet/manager-config",
  "version": "0.35.1",
  "description": "Scramjet CPM Config",
  "main": "src/index.ts",
  "scripts": {
    "build": "../../scripts/build-all.js --config-name=tsconfig.build.json --copy-dist",
    "clean": "rm -rf ./dist .bic_cache",
    "watch": "tsc -b --watch",
    "test": "npm run test:ava",
    "test:ava": "TS_NODE_TRANSPILE_ONLY=1 node ../../scripts/run-ava.js -T 60000"
  },
  "dependencies": {
    "@scramjet/api-types": "^1.1.0",
    "@scramjet/utility": "^1.1.0"
  },
  "devDependencies": {
    "@scramjet/runtime-types": "^1.1.0",
    "@scramjet/types": "^1.1.0",
    "ava": "^3.15.0"
  },
  "ava": {
    "extensions": [
      "ts"
    ],
    "files": [
      "**/*.spec.ts"
    ],
    "require": [
      "ts-node/register"
    ]
  },
  "author": "Scramjet <open-source@scramjet.org>",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/scramjetorg/scramjet-cpm-dev.git"
  }
}
