{
  "name": "@scramjet/sequence-types",
  "version": "2.0.0",
  "description": "Sequence-author-facing types for Scramjet Transform Hub. Exports the frozen sequence AppContext API backed by BaseAppContext from @scramjet/runtime-types, plus canonical sequence application/function types for sequence authors.",
  "main": "./src/index.ts",
  "scripts": {
    "build": "../../scripts/build-all.js --config-name=tsconfig.build.json --copy-dist",
    "clean": "rm -rf ./dist .bic_cache",
    "test": "tsc --noEmit && node test/no-forbidden-deps.cjs"
  },
  "author": "Scramjet <open-source@scramjet.org>",
  "license": "MIT",
  "dependencies": {
    "@scramjet/runtime-types": "^2.0.0",
    "@scramjet/symbols": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "~4.7.4"
  },
  "files": [
    "**/*.js",
    "**/*.d.ts",
    "**/*.json",
    "!src/**",
    "!test/**",
    "!tests/**",
    "!**/*.map",
    "!**/*.tsbuildinfo"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/scramjetorg/transform-hub.git",
    "directory": "packages/sequence-types"
  }
}
