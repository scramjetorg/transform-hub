{
  "name": "@scramjet/types",
  "version": "2.0.0",
  "description": "[DEPRECATED] This package is part of Scramjet Transform Hub. The package holds the typescript definitions for all common STH interfaces. Deprecated in favor of @scramjet/runtime-types, @scramjet/sequence-types, and @scramjet/api-types. Existing imports continue to resolve; new code should import from the split packages.",
  "main": "./src/index.ts",
  "scripts": {
    "clean": "rm -rf ./dist .bic_cache",
    "build": "../../scripts/build-all.js --config-name=tsconfig.build.json --copy-dist",
    "test:expose": "scripts/generate.js",
    "test": "npm run test:expose && node ../../node_modules/typescript/bin/tsc -p ./tsconfig.test.json --noEmit",
    "build:only": "npm run test:expose"
  },
  "author": "Scramjet <open-source@scramjet.org>",
  "license": "MIT",
  "dependencies": {
    "@scramjet/api-types": "^2.0.0",
    "@scramjet/symbols": "^2.0.0",
    "http-status-codes": "^2.2.0",
    "typed-emitter": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "scramjet": "^4.37.0",
    "typescript": "~4.7.4"
  },
  "files": [
    "**/*.js",
    "**/*.d.ts",
    "**/*.json",
    "!src/**",
    "!test/**",
    "!tests/**",
    "!**/*.map",
    "!**/*.tsbuildinfo"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/scramjetorg/transform-hub.git",
    "directory": "packages/types"
  }
}
