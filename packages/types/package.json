{
  "name": "@scramjet/types",
  "version": "1.1.0",
  "description": "This package is part of Scramjet Transform Hub. The package holds the typescript definitions for all common STH interfaces.",
  "main": "./src/index.ts",
  "scripts": {
    "clean": "rm -rf ./dist .bic_cache",
    "build": "../../scripts/build-all.js --config-name=tsconfig.build.json --copy-dist",
    "build:docs": "node -e \"console.log('Package TypeDoc generation retired; run npm run docs:generate from the repository root.')\"",
    "test:expose": "scripts/generate.js",
    "test": "npm run test:expose && node ../../node_modules/typescript/bin/tsc -p ./tsconfig.test.json --noEmit",
    "build:only": "npm run test:expose"
  },
  "author": "Scramjet <open-source@scramjet.org>",
  "license": "AGPL-3.0",
  "dependencies": {
    "@scramjet/symbols": "^1.1.0",
    "http-status-codes": "^2.2.0",
    "typed-emitter": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "scramjet": "^4.37.0",
    "typedoc": "0.23.17",
    "typedoc-plugin-markdown": "3.13.6",
    "typescript": "~4.7.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/scramjetorg/transform-hub.git"
  }
}
