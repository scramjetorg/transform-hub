{
  "name": "@scramjet/manager",
  "version": "2.0.0",
  "description": "Scramjet Manager",
  "main": "src/index.ts",
  "bin": {
    "manager-csr-enrollment": "src/bin/csr-enrollment.ts"
  },
  "scripts": {
    "start": "ts-node ./src/bin/start",
    "build": "../../scripts/build-all.js --config-name=tsconfig.build.json --copy-dist",
    "clean": "rm -rf ./dist .bic_cache",
    "watch": "tsc -b --watch",
    "test": "npm run test:ava",
    "test:ava": "TS_NODE_TRANSPILE_ONLY=1 SCRAMJET_AVA_FETCH=0 node ../../scripts/run-ava.js -T 120000",
    "prebuild": "npm run savehash",
    "savehash": "node ../../scripts/hash-to-file.js ./src/"
  },
  "dependencies": {
    "@scramjet/adapter-process": "^2.0.0",
    "@scramjet/api-client": "^2.0.0",
    "@scramjet/api-router": "^2.0.0",
    "@scramjet/api-server": "^2.0.0",
    "@scramjet/api-types": "^2.0.0",
    "@scramjet/client-utils": "^2.0.0",
    "@scramjet/config": "^2.0.0",
    "@scramjet/load-check": "^2.0.0",
    "@scramjet/model": "^2.0.0",
    "@scramjet/obj-logger": "^2.0.0",
    "@scramjet/rest-api2": "^2.0.0",
    "@scramjet/runtime-types": "^2.0.0",
    "@scramjet/symbols": "^2.0.0",
    "@scramjet/utility": "^2.0.0",
    "@signicode/verser-common": "0.5.0",
    "@signicode/verser2-guest-node": "0.7.0",
    "@signicode/verser2-host": "0.7.0",
    "find-package-json": "^1.2.0",
    "http-status-codes": "^2.2.0",
    "minio": "^8.0.7",
    "rereadable-stream": "^1.4.13",
    "scramjet": "^4.37.0",
    "selfsigned": "^5.5.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@ava/typescript": "^7.0.0",
    "@scramjet/types": "^2.0.0",
    "@types/find-package-json": "^1.2.3",
    "@types/node": "^22.15.0",
    "ava": "^8.0.0",
    "ts-node": "^10.9.1",
    "typescript": "^4.7.4"
  },
  "ava": {
    "files": [
      "**/*.spec.ts"
    ],
    "require": [
      "ts-node/register"
    ],
    "typescript": {
      "compile": false,
      "rewritePaths": {
        "./": "../.ava-manager/"
      }
    }
  },
  "author": "Scramjet <open-source@scramjet.org>",
  "license": "MIT",
  "files": [
    "**/*.js",
    "**/*.d.ts",
    "**/*.json",
    "!src/**",
    "!test/**",
    "!tests/**",
    "!**/*.map",
    "!**/*.tsbuildinfo"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/scramjetorg/transform-hub.git",
    "directory": "packages/manager"
  }
}
