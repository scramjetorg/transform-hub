{
  "name": "@scramjet/manager",
  "version": "0.35.1",
  "description": "Scramjet Manager",
  "main": "src/index.ts",
  "scripts": {
    "start": "ts-node ./src/bin/start",
    "build": "../../scripts/build-all.js --config-name=tsconfig.build.json --copy-dist",
    "build:docs": "typedoc",
    "clean": "rm -rf ./dist .bic_cache",
    "watch": "tsc -b --watch",
    "test": "npm run test:ava",
    "test:ava": "node ../../scripts/run-ava.js",
    "prebuild": "npm run savehash",
    "savehash": "node ../../scripts/hash-to-file.js ./src/"
  },
  "dependencies": {
    "@scramjet/adapter-process": "^1.1.0",
    "@scramjet/api-client": "^1.1.0",
    "@scramjet/api-server": "^1.1.0",
    "@scramjet/client-utils": "^1.1.0",
    "@scramjet/config": "^1.1.0",
    "@scramjet/load-check": "^1.1.0",
    "@scramjet/manager-config": "^0.35.1",
    "@scramjet/model": "^1.1.0",
    "@scramjet/obj-logger": "^1.1.0",
    "@scramjet/symbols": "^1.1.0",
    "@scramjet/types": "^1.1.0",
    "@scramjet/utility": "^1.1.0",
    "@signicode/verser-common": "0.3.1",
    "@signicode/verser2-guest-node": "0.3.1",
    "find-package-json": "^1.2.0",
    "http-status-codes": "^2.2.0",
    "minio": "^7.1.3",
    "rereadable-stream": "^1.4.13",
    "scramjet": "^4.37.0"
  },
  "devDependencies": {
    "@types/find-package-json": "^1.2.3",
    "@types/node": "^22.15.0",
    "ava": "^3.15.0",
    "ts-node": "^10.9.1",
    "typedoc": "^0.22.18",
    "typedoc-plugin-markdown": "^3.13.4",
    "typescript": "^4.7.4"
  },
  "ava": {
    "extensions": [
      "ts"
    ],
    "files": [
      "**/*.spec.ts"
    ],
    "require": [
      "ts-node/register"
    ]
  },
  "author": "Scramjet <open-source@scramjet.org>",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/scramjetorg/scramjet-cpm-dev.git"
  }
}
