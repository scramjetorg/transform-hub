{
  "name": "@scramjet/model",
  "version": "2.0.0",
  "description": "This package is part of Scramjet Transform Hub. The package provides the domain model for STH and the CLI.",
  "main": "./src/index.ts",
  "scripts": {
    "start": "ts-node ./src/index",
    "build": "../../scripts/build-all.js --config-name=tsconfig.build.json --copy-dist",
    "clean": "rm -rf ./dist .bic_cache",
    "test": "nyc node ../../scripts/run-ava.js"
  },
  "author": "Scramjet <open-source@scramjet.org>",
  "license": "MIT",
  "dependencies": {
    "@scramjet/obj-logger": "^2.0.0",
    "@scramjet/symbols": "^2.0.0",
    "scramjet": "^4.37.0",
    "uuid": "^8.3.2"
  },
  "devDependencies": {
    "@scramjet/runtime-types": "^2.0.0",
    "@scramjet/types": "^2.0.0",
    "@types/node": "^22.15.0",
    "@types/uuid": "^8.3.4",
    "ava": "^3.15.0",
    "ts-node": "^10.9.1",
    "typescript": "~4.7.4"
  },
  "ava": {
    "extensions": [
      "ts"
    ],
    "files": [
      "**/*.spec.ts"
    ],
    "require": [
      "ts-node/register"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/scramjetorg/transform-hub.git"
  }
}
