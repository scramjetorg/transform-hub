{
  "name": "@scramjet/api-server",
  "version": "1.1.0",
  "description": "This package is part of Scramjet Transform Hub. The package provides the domain model for STH and the CLI.",
  "main": "./src/index.ts",
  "scripts": {
    "start": "ts-node ./src/index",
    "build": "../../scripts/build-all.js --config-name=tsconfig.build.json --copy-dist",
    "clean": "rm -rf ./dist .bic_cache",
    "test": "npm run test:ava",
    "test:ava": "SCRAMJET_AVA_FETCH=0 node ../../scripts/run-ava.js -T 50000 --serial"
  },
  "author": "Scramjet <open-source@scramjet.org>",
  "license": "AGPL-3.0",
  "dependencies": {
    "0http": "^3.4.1",
    "@scramjet/api-types": "^1.1.0",
    "@scramjet/api-router": "^1.1.0",
    "@scramjet/model": "^1.1.0",
    "@scramjet/obj-logger": "^1.1.0",
    "@scramjet/runtime-types": "^1.1.0",
    "@scramjet/symbols": "^1.1.0",
    "@scramjet/utility": "^1.1.0",
    "http-status-codes": "^2.2.0",
    "scramjet": "^4.37.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/sinon": "^10.0.13",
    "@types/trouter": "^3.1.1",
    "ava": "^3.15.0",
    "sinon": "^14.0.1",
    "trouter": "^3.2.0",
    "ts-node": "^10.9.1",
    "typescript": "~4.7.4"
  },
  "ava": {
    "extensions": [
      "ts"
    ],
    "files": [
      "test/0http.spec.ts",
      "test/server.spec.ts",
      "test/stream-methods.spec.ts",
      "test/rest-methods.spec.ts",
      "test/support.spec.ts",
      "test/handler-execution.spec.ts",
      "test/routed-forward.spec.ts",
      "test/routed-redirect.spec.ts",
      "test/v2-http-dispatcher.spec.ts"
    ],
    "require": [
      "ts-node/register"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/scramjetorg/transform-hub.git"
  }
}
