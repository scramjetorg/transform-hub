{
  "name": "@scramjet/platform-types",
  "version": "0.35.1",
  "description": "Scramjet Platform types",
  "main": "src/index.ts",
  "scripts": {
    "start": "ts-node ./src/index",
    "build": "../../scripts/build-all.js --config-name=tsconfig.build.json --copy-dist",
    "build:docs": "typedoc",
    "clean": "rm -rf ./dist .bic_cache",
    "watch": "tsc -b --watch",
    "test": "echo no tests yet -- # npm run test:ava",
    "test:ava": "ava"
  },
  "dependencies": {
    "@scramjet/api-server": "^1.1.0",
    "@scramjet/utility": "^1.1.0",
    "@scramjet/verser": "^1.1.0"
  },
  "devDependencies": {
    "@scramjet/types": "^1.1.0",
    "@types/auth0": "^2.35.3",
    "@types/node": "^22.15.0",
    "ava": "^3.15.0",
    "ts-node": "^10.9.1",
    "typedoc": "^0.22.18",
    "typedoc-plugin-markdown": "^3.13.4",
    "typescript": "^4.7.4"
  },
  "ava": {
    "extensions": [
      "ts"
    ],
    "files": [
      "**/*.spec.ts"
    ],
    "require": [
      "ts-node/register"
    ]
  },
  "author": "Scramjet <open-source@scramjet.org>",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/scramjetorg/scramjet-cpm-dev.git"
  }
}
