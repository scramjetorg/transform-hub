{
  "name": "@scramjet/logger",
  "version": "2.0.0",
  "description": "This package is part of Scramjet Transform Hub. The package provides a simple logger with 100% Console Web API compatible signatures and a streaming output of any choice.",
  "main": "./src/index.ts",
  "scripts": {
    "start": "ts-node ./src/index",
    "build": "../../scripts/build-all.js --config-name=tsconfig.build.json --copy-dist",
    "test": "npm run test:ava",
    "test:ava": "nyc node ../../scripts/run-ava.js",
    "clean": "rm -rf ./dist .bic_cache"
  },
  "author": "Scramjet <open-source@scramjet.org>",
  "license": "AGPL-3.0",
  "devDependencies": {
    "@scramjet/runtime-types": "^2.0.0",
    "@scramjet/types": "^2.0.0",
    "@types/node": "^22.15.0",
    "ava": "^3.15.0",
    "nyc": "^15.1.0",
    "ts-node": "^10.9.1",
    "typescript": "~4.7.4"
  },
  "dependencies": {
    "scramjet": "^4.37.0"
  },
  "ava": {
    "extensions": [
      "ts"
    ],
    "files": [
      "**/*.spec.ts"
    ],
    "require": [
      "ts-node/register"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/scramjetorg/transform-hub.git"
  }
}
