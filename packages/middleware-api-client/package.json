{
  "name": "@scramjet/middleware-api-client",
  "version": "2.0.0",
  "description": "Scramjet Middleware API Client",
  "main": "src/index.ts",
  "scripts": {
    "build": "../../scripts/build-all.js --config-name=tsconfig.build.json --copy-dist",
    "build:browser": "esbuild ./src/index.ts --outdir=bundle --bundle --platform=browser --format=iife --tsconfig=tsconfig.build.json --target=chrome58 --global-name=SCPClient --alias:http=./src/browser-node-stubs.ts --alias:https=./src/browser-node-stubs.ts --alias:url=./src/browser-node-stubs.ts && npm run build:browser:types",
    "build:browser:types": "tsc --emitDeclarationOnly --declaration --project tsconfig.build.json --outDir bundle",
    "clean": "rm -rf ./dist .bic_cache",
    "watch": "tsc -b --watch",
    "test": "npm run test:ava",
    "test:ava": "node ../../scripts/run-ava.js"
  },
  "dependencies": {
    "@scramjet/api-client": "^2.0.0",
    "@scramjet/api-types": "^2.0.0",
    "@scramjet/client-utils": "^2.0.0",
    "@scramjet/multi-manager-api-client": "^2.0.0"
  },
  "devDependencies": {
    "@ava/typescript": "^7.0.0",
    "ava": "^8.0.0",
    "esbuild": "^0.28.0",
    "ts-node": "^10.9.1",
    "typescript": "~4.7.4"
  },
  "ava": {
    "files": [
      "**/*.spec.ts"
    ],
    "require": [
      "ts-node/register"
    ],
    "typescript": {
      "compile": false,
      "rewritePaths": {
        "./": "../.ava-middleware-api-client/"
      }
    }
  },
  "author": "Scramjet <open-source@scramjet.org>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/scramjetorg/scramjet-cpm-dev.git"
  }
}
