{
  "name": "@scramjet/api-router",
  "version": "2.0.0",
  "description": "Schema-aware API route declaration, manifest, and client contract package for Scramjet Transform Hub.",
  "main": "./src/index.ts",
  "bin": {
    "scramjet-api-router-generate": "./src/bin/generate.ts"
  },
  "scripts": {
    "start": "ts-node ./src/index",
    "build": "../../scripts/build-all.js --config-name=tsconfig.build.json --copy-dist",
    "clean": "rm -rf ./dist .bic_cache",
    "test": "npm run test:ava",
    "test:ava": "node ../../scripts/run-ava.js -T 50000"
  },
  "author": "Scramjet <open-source@scramjet.org>",
  "license": "MIT",
  "dependencies": {
    "@scramjet/api-types": "^2.0.0",
    "@scramjet/config": "^2.0.0",
    "@scramjet/runtime-types": "^2.0.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@ava/typescript": "^7.0.0",
    "@types/node": "^22.15.0",
    "ava": "^8.0.0",
    "ts-node": "^10.9.1",
    "typescript": "~4.7.4"
  },
  "ava": {
    "files": [
      "test/**/*.spec.ts"
    ],
    "require": [
      "ts-node/register"
    ],
    "typescript": {
      "compile": false,
      "rewritePaths": {
        "./": "../.ava-api-router/"
      }
    }
  },
  "files": [
    "**/*.js",
    "**/*.d.ts",
    "**/*.json",
    "!src/**",
    "!test/**",
    "!tests/**",
    "!**/*.map",
    "!**/*.tsbuildinfo"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/scramjetorg/transform-hub.git",
    "directory": "packages/api-router"
  }
}
