{
  "name": "@scramjet/sequence-test",
  "version": "2.0.0",
  "description": "Test harness for Scramjet Transform Sequences using the runner protocol without starting a full Transform Hub. Supported for scoped local sequence fixture/harness validation.",
  "main": "./src/index.ts",
  "scripts": {
    "build": "../../scripts/build-all.js --config-name=tsconfig.build.json --copy-dist",
    "clean": "rm -rf ./dist .bic_cache",
    "test": "node ../../scripts/run-ava.js"
  },
  "author": "Scramjet <opensource@scramjet.org>",
  "license": "MIT",
  "dependencies": {
    "@scramjet/runner": "^2.0.0",
    "@scramjet/symbols": "^2.0.0",
    "@scramjet/runtime-types": "^2.0.0"
  },
  "devDependencies": {
    "@ava/typescript": "^7.0.0",
    "@scramjet/sequence-types": "^2.0.0",
    "@types/node": "^22.15.0",
    "ava": "^8.0.0",
    "ts-node": "^10.9.1",
    "typescript": "~4.7.4"
  },
  "ava": {
    "files": [
      "**/*.spec.ts"
    ],
    "require": [
      "ts-node/register"
    ],
    "typescript": {
      "compile": false,
      "rewritePaths": {
        "./": "../.ava-sequence-test/"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/scramjetorg/transform-hub.git"
  }
}
