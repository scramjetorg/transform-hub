{
  "name": "@scramjet/multi-manager-api-client",
  "version": "2.0.0",
  "description": "Scramjet MultiManager API Client",
  "main": "src/index.ts",
  "scripts": {
    "build": "../../scripts/build-all.js --config-name=tsconfig.build.json --copy-dist",
    "clean": "rm -rf ./dist .bic_cache",
    "watch": "tsc -b --watch",
    "test": "npm run test:ava",
    "test:ava": "node ../../scripts/run-ava.js"
  },
  "dependencies": {
    "@scramjet/api-client": "^2.0.0",
    "@scramjet/client-utils": "^2.0.0",
    "@scramjet/api-types": "^2.0.0",
    "@scramjet/runtime-types": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "ava": "^3.15.0",
    "ts-node": "^10.9.1",
    "typescript": "~4.7.4"
  },
  "ava": {
    "extensions": [
      "ts"
    ],
    "files": [
      "**/*.spec.ts"
    ],
    "require": [
      "ts-node/register"
    ]
  },
  "author": "Scramjet <open-source@scramjet.org>",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/scramjetorg/scramjet-cpm-dev.git"
  }
}
