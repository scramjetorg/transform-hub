{
  "name": "@scramjet/multi-manager-api-client",
  "version": "2.3.0",
  "description": "Scramjet MultiManager API Client",
  "main": "src/index.ts",
  "scripts": {
    "build": "../../scripts/build-all.js --config-name=tsconfig.build.json --copy-dist",
    "clean": "rm -rf ./dist .bic_cache",
    "watch": "tsc -b --watch",
    "test": "npm run test:ava",
    "test:ava": "node ../../scripts/run-ava.js"
  },
  "dependencies": {
    "@scramjet/api-client": "^2.3.0",
    "@scramjet/client-utils": "^2.3.0",
    "@scramjet/api-types": "^2.3.0",
    "@scramjet/runtime-types": "^2.3.0"
  },
  "devDependencies": {
    "@ava/typescript": "^7.0.0",
    "@types/node": "^22.15.0",
    "ava": "^8.0.0",
    "typescript": "5.9.3",
    "tsx": "^4.19.3"
  },
  "ava": {
    "files": [
      "**/*.spec.ts"
    ],
    "require": [
      "../../scripts/lib/tsx-cjs-register.cjs"
    ],
    "typescript": {
      "compile": false,
      "rewritePaths": {
        "./": "../.ava-multi-manager-api-client/"
      }
    }
  },
  "author": "Scramjet <open-source@scramjet.org>",
  "license": "MIT",
  "files": [
    "**/*.js",
    "**/*.d.ts",
    "**/*.json",
    "!src/**",
    "!test/**",
    "!tests/**",
    "!**/*.map",
    "!**/*.tsbuildinfo"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/scramjetorg/transform-hub.git",
    "directory": "packages/multi-manager-api-client"
  }
}
