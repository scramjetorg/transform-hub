{
  "name": "@scramjet/adapters",
  "version": "2.0.0",
  "description": "This package is part of Scramjet Transform Hub. This module holds the docker adapters utilized by Scramjet Transform Hub",
  "main": "./src/index.ts",
  "scripts": {
    "start": "ts-node ./src/index",
    "build": "../../scripts/build-all.js --config-name=tsconfig.build.json --copy-dist",
    "clean": "rm -rf ./dist .bic_cache",
    "cloc": "cloc src --fullpath --include-lang TypeScript --not-match-d \"(node_modules|test|dist|bdd)\" --by-percent cm",
    "test": "nyc node ../../scripts/run-ava.js",
    "prepack": "node ../../scripts/publish.js"
  },
  "author": "Scramjet <open-source@scramjet.org>",
  "license": "MIT",
  "dependencies": {
    "@scramjet/adapter-docker": "^2.0.0",
    "@scramjet/adapter-kubernetes": "^2.0.0",
    "@scramjet/adapter-process": "^2.0.0",
    "@scramjet/api-types": "^2.0.0"
  },
  "devDependencies": {
    "@ava/typescript": "^7.0.0",
    "@scramjet/runtime-types": "^2.0.0",
    "@scramjet/types": "^2.0.0",
    "@types/node": "^22.15.0",
    "ava": "^8.0.0",
    "ts-node": "^10.9.1",
    "typescript": "~4.7.4"
  },
  "ava": {
    "files": [
      "**/*.spec.ts"
    ],
    "require": [
      "ts-node/register"
    ],
    "typescript": {
      "compile": false,
      "rewritePaths": {
        "./": "../.ava-adapters/"
      }
    }
  },
  "files": [
    "**/*.js",
    "**/*.d.ts",
    "**/*.json",
    "!src/**",
    "!test/**",
    "!tests/**",
    "!**/*.map",
    "!**/*.tsbuildinfo"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/scramjetorg/transform-hub.git",
    "directory": "packages/adapters"
  }
}
