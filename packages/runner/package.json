{
  "name": "@scramjet/runner",
  "version": "1.1.0",
  "description": "This package is part of Scramjet Transform Hub. The package executes the remote runners and provides communication with them through abstraction layer provided by adapters.",
  "main": "./src/bin/start-runner.ts",
  "scripts": {
    "build": "../../scripts/build-all.js --config-name=tsconfig.build.json --copy-dist",
    "prebuild:docker": "cd ../.. && scripts/build-all.js --no-install --link-packages -d packages/runner -o ./dist/docker-runner/ --ts-config tsconfig.build.json",
    "build:docker": "docker build -t scramjetorg/runner:$(git rev-parse HEAD) -t scramjetorg/runner:dev -f Dockerfile ../../",
    "preexport:docker": "mkdir -p ../../dist/docker && rm -rf ../../dist/docker/scramjetorg-runner.tar.gz",
    "export:docker": "npm run build:docker && docker save scramjetorg/runner:$(git rev-parse HEAD) | gzip > ../../dist/docker/scramjetorg-runner.tar.gz",
    "start": "ts-node ./src/index",
    "test": "TS_NODE_TRANSPILE_ONLY=1 SCRAMJET_AVA_MAX_OLD_SPACE_SIZE=1024 SCRAMJET_AVA_FETCH=0 node ../../scripts/run-ava.js -T 120000 --serial",
    "test:docker": "docker run -i --name runner -v prerunner-$(git rev-parse --short HEAD):/package scramjetorg/runner:$(git rev-parse HEAD)",
    "clean": "rm -rf ./dist .bic_cache",
    "clean:docker": "docker rm -f runner; docker volume rm prerunner-$(git rev-parse HEAD)"
  },
  "author": "Scramjet <opensource@scramjet.org>",
  "license": "MIT",
  "dependencies": {
    "@scramjet/api-client": "^1.1.0",
    "@scramjet/api-server": "^1.1.0",
    "@scramjet/api-types": "^1.1.0",
    "@scramjet/client-utils": "^1.1.0",
    "@scramjet/model": "^1.1.0",
    "@scramjet/obj-logger": "^1.1.0",
    "@scramjet/rest-api2": "^1.1.0",
    "@scramjet/runner-bun": "^1.1.0",
    "@scramjet/runner-node": "^1.1.0",
    "@scramjet/runtime-types": "^1.1.0",
    "@scramjet/sequence-types": "^1.1.0",
    "@scramjet/symbols": "^1.1.0",
    "@scramjet/utility": "^1.1.0",
    "@signicode/verser2-guest-node": "0.5.0",
    "scramjet": "^4.37.0"
  },
  "devDependencies": {
    "@scramjet/types": "^1.1.0",
    "@types/node": "^22.15.0",
    "@types/sinon": "^10.0.13",
    "ava": "^3.15.0",
    "nyc": "^15.1.0",
    "proxyquire": "^2.1.3",
    "sinon": "^14.0.1",
    "ts-node": "^10.9.1",
    "typescript": "~4.7.4"
  },
  "ava": {
    "extensions": [
      "ts",
      "js"
    ],
    "files": [
      "**/*.spec.ts"
    ],
    "require": [
      "ts-node/register"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/scramjetorg/transform-hub.git"
  }
}
