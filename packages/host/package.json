{
  "name": "@scramjet/host",
  "version": "1.1.0",
  "description": "This package is part of Scramjet Transform Hub. The package provides the main host subsystem of STH - starts API Servers, creates adapters etc.",
  "main": "./src/index.ts",
  "scripts": {
    "start": "ts-node ./src/index",
    "build": "../../scripts/build-all.js --config-name=tsconfig.build.json --copy-dist",
    "build:docs": "node -e \"console.log('Package TypeDoc generation retired; run npm run docs:generate from the repository root.')\"",
    "clean": "rm -rf ./dist .bic_cache",
    "cloc": "cloc src --fullpath --include-lang TypeScript --not-match-d \"(node_modules|test|dist|bdd)\" --by-percent cm",
    "test": "node ../../scripts/run-ava.js",
    "prebuild": "npm run savehash",
    "savehash": "node ../../scripts/hash-to-file.js ./src/"
  },
  "author": "Scramjet <open-source@scramjet.org>",
  "license": "AGPL-3.0",
  "dependencies": {
    "@scramjet/adapters": "^1.1.0",
    "@scramjet/api-router": "^1.1.0",
    "@scramjet/api-server": "^1.1.0",
    "@scramjet/load-check": "^1.1.0",
    "@scramjet/model": "^1.1.0",
    "@scramjet/monitoring-server": "^1.1.0",
    "@scramjet/obj-logger": "^1.1.0",
    "@scramjet/sth-config": "^1.1.0",
    "@scramjet/symbols": "^1.1.0",
    "@scramjet/rest-api2": "^1.1.0",
    "@scramjet/telemetry": "^1.1.0",
    "@scramjet/utility": "^1.1.0",
    "@signicode/verser-common": "0.4.2",
    "@signicode/verser2-guest-node": "0.4.2",
    "@signicode/verser2-host": "0.4.2",
    "find-package-json": "^1.2.0",
    "http-status-codes": "^2.2.0",
    "minimist": "^1.2.6",
    "nano": "^10.1.4",
    "node-localstorage": "^3.0.5",
    "pico-s3": "^2.6.0",
    "rereadable-stream": "^1.4.14",
    "scramjet": "^4.37.0",
    "selfsigned": "^5.5.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@scramjet/types": "^1.1.0",
    "@types/aws4": "^1.11.0",
    "@types/find-package-json": "^1.2.3",
    "@types/node": "^22.15.0",
    "@types/node-localstorage": "^1.3.3",
    "ava": "^3.15.0",
    "axios": "^1.9.0",
    "ts-node": "^10.9.1",
    "typedoc": "0.23.17",
    "typedoc-plugin-markdown": "3.13.6",
    "typescript": "~4.7.4"
  },
  "ava": {
    "extensions": [
      "ts"
    ],
    "files": [
      "!**/*.d.ts",
      "**/*.spec.ts",
      "**/*.test.ts"
    ],
    "require": [
      "ts-node/register"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/scramjetorg/transform-hub.git"
  }
}
