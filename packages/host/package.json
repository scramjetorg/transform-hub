{
  "name": "@scramjet/host",
  "version": "2.3.1",
  "description": "This package is part of Scramjet Transform Hub. The package provides the main host subsystem of STH - starts API Servers, creates adapters etc.",
  "main": "./src/index.ts",
  "scripts": {
    "start": "tsx ./src/index",
    "build": "../../scripts/build-all.js --config-name=tsconfig.build.json --copy-dist",
    "clean": "rm -rf ./dist .bic_cache",
    "cloc": "cloc src --fullpath --include-lang TypeScript --not-match-d \"(node_modules|test|dist|bdd)\" --by-percent cm",
    "test": "SCRAMJET_AVA_FETCH=0 node ../../scripts/run-ava.js -T 50000",
    "prebuild": "npm run savehash",
    "savehash": "node ../../scripts/hash-to-file.js ./src/"
  },
  "author": "Scramjet <open-source@scramjet.org>",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1150.0",
    "@smithy/node-http-handler": "^4.12.1",
    "@scramjet/adapters": "^2.3.1",
    "@scramjet/api-router": "^2.3.1",
    "@scramjet/api-server": "^2.3.1",
    "@scramjet/api-types": "^2.3.1",
    "@scramjet/load-check": "^2.3.1",
    "@scramjet/model": "^2.3.1",
    "@scramjet/monitoring-server": "^2.3.1",
    "@scramjet/obj-logger": "^2.3.1",
    "@scramjet/rest-api2": "^2.3.1",
    "@scramjet/hub-state": "^2.3.1",
    "@scramjet/config": "^2.3.1",
    "@scramjet/symbols": "^2.3.1",
    "@scramjet/telemetry": "^2.3.1",
    "@scramjet/utility": "^2.3.1",
    "@signicode/verser-common": "0.9.3",
    "@signicode/verser2-guest-node": "0.9.3",
    "@signicode/verser2-host": "0.9.3",
    "find-package-json": "^1.2.0",
    "http-status-codes": "^2.2.0",
    "minimist": "^1.2.6",
    "nano": "^11.0.7",
    "node-localstorage": "^3.0.5",
    "rereadable-stream": "^1.4.14",
    "scramjet": "^4.37.0",
    "@peculiar/x509": "^1.14.3",
    "zod": "^3.25.67",
    "@scramjet/runtime-types": "^2.3.1"
  },
  "devDependencies": {
    "@ava/typescript": "^7.0.0",
    "@scramjet/api-types": "^2.3.1",
    "@scramjet/runtime-types": "^2.3.1",
    "@scramjet/types": "^2.3.1",
    "@types/find-package-json": "^1.2.3",
    "@types/node": "^22.15.0",
    "@types/node-localstorage": "^1.3.3",
    "ava": "^8.0.0",
    "typescript": "5.9.3",
    "tsx": "^4.23.15"
  },
  "ava": {
    "files": [
      "!**/*.d.ts",
      "**/*.spec.ts",
      "**/*.test.ts"
    ],
    "require": [
      "../../scripts/lib/tsx-cjs-register.cjs"
    ],
    "typescript": {
      "compile": false,
      "rewritePaths": {
        "./": "../.ava-host/"
      }
    }
  },
  "files": [
    "**/*.js",
    "**/*.d.ts",
    "**/*.json",
    "!src/**",
    "!test/**",
    "!tests/**",
    "!**/*.map",
    "!**/*.tsbuildinfo"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/scramjetorg/transform-hub.git",
    "directory": "packages/host"
  }
}
