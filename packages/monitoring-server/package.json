{
  "name": "@scramjet/monitoring-server",
  "version": "2.0.0",
  "description": "Scramjet Monitoring Server",
  "main": "src/index.ts",
  "scripts": {
    "build": "../../scripts/build-all.js --config-name=tsconfig.build.json --copy-dist",
    "clean": "rm -rf ./dist .bic_cache",
    "watch": "tsc -b --watch",
    "test": "npm run test:ava",
    "test:ava": "node -e \"\""
  },
  "dependencies": {
    "@scramjet/api-types": "^2.0.0",
    "@scramjet/utility": "^2.0.0"
  },
  "devDependencies": {
    "@ava/typescript": "^7.0.0",
    "@scramjet/types": "^2.0.0",
    "@types/node": "^22.15.0",
    "ava": "^8.0.0",
    "ts-node": "^10.9.1",
    "typescript": "~4.7.4"
  },
  "ava": {
    "files": [
      "**/*.spec.ts"
    ],
    "require": [
      "ts-node/register"
    ],
    "typescript": {
      "compile": false,
      "rewritePaths": {
        "./": "../.ava-monitoring-server/"
      }
    }
  },
  "author": "Scramjet <open-source@scramjet.org>",
  "license": "MIT",
  "files": [
    "**/*.js",
    "**/*.d.ts",
    "**/*.json",
    "!src/**",
    "!test/**",
    "!tests/**",
    "!**/*.map",
    "!**/*.tsbuildinfo"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/scramjetorg/transform-hub.git",
    "directory": "packages/monitoring-server"
  }
}
