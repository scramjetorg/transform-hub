{
  "name": "@scramjet/adapters-common",
  "version": "2.2.2-devel",
  "description": "This package is part of Scramjet Transform Hub. This module holds the common items held by adapters utilized by Scramjet Transform Hub",
  "main": "./src/index.ts",
  "scripts": {
    "start": "tsx ./src/index",
    "build": "../../scripts/build-all.js --config-name=tsconfig.build.json --copy-dist",
    "clean": "rm -rf ./dist .bic_cache",
    "cloc": "cloc src --fullpath --include-lang TypeScript --not-match-d \"(node_modules|test|dist|bdd)\" --by-percent cm",
    "test": "node ../../scripts/run-ava.js",
    "prepack": "node ../../scripts/publish.js"
  },
  "author": "Scramjet <open-source@scramjet.org>",
  "license": "MIT",
  "dependencies": {
    "@scramjet/api-types": "^2.2.2-devel",
    "@scramjet/runtime-types": "^2.2.2-devel",
    "@scramjet/symbols": "^2.2.2-devel",
    "@scramjet/utility": "^2.2.2-devel",
    "ts.data.json": "^2.2.0"
  },
  "devDependencies": {
    "@ava/typescript": "^7.0.0",
    "@scramjet/types": "^2.2.2-devel",
    "@types/node": "^22.15.0",
    "ava": "^8.0.0",
    "typescript": "~4.7.4",
    "tsx": "^4.19.3"
  },
  "ava": {
    "files": [
      "**/*.spec.ts"
    ],
    "require": [
      "../../scripts/lib/tsx-cjs-register.cjs"
    ],
    "typescript": {
      "compile": false,
      "rewritePaths": {
        "./": "../.ava-adapters-common/"
      }
    }
  },
  "files": [
    "**/*.js",
    "**/*.d.ts",
    "**/*.json",
    "!src/**",
    "!test/**",
    "!tests/**",
    "!**/*.map",
    "!**/*.tsbuildinfo"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/scramjetorg/transform-hub.git",
    "directory": "packages/adapters-common"
  }
}
