{
  "name": "@scramjet/adapters-common",
  "version": "1.1.0",
  "description": "This package is part of Scramjet Transform Hub. This module holds the common items held by adapters utilized by Scramjet Transform Hub",
  "main": "./src/index.ts",
  "scripts": {
    "start": "ts-node ./src/index",
    "build": "../../scripts/build-all.js --config-name=tsconfig.build.json --copy-dist",
    "clean": "rm -rf ./dist .bic_cache",
    "cloc": "cloc src --fullpath --include-lang TypeScript --not-match-d \"(node_modules|test|dist|bdd)\" --by-percent cm",
    "test": "nyc node ../../scripts/run-ava.js",
    "prepack": "node ../../scripts/publish.js"
  },
  "author": "Scramjet <open-source@scramjet.org>",
  "license": "AGPL-3.0",
  "dependencies": {
    "@scramjet/api-types": "^1.1.0",
    "@scramjet/runtime-types": "^1.1.0",
    "@scramjet/symbols": "^1.1.0",
    "@scramjet/utility": "^1.1.0",
    "ts.data.json": "^2.2.0"
  },
  "devDependencies": {
    "@scramjet/types": "^1.1.0",
    "@types/node": "^22.15.0",
    "ava": "^4.3.3",
    "ts-node": "^10.9.1",
    "typescript": "~4.7.4"
  },
  "ava": {
    "extensions": [
      "ts"
    ],
    "files": [
      "**/*.spec.ts"
    ],
    "require": [
      "ts-node/register"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/scramjetorg/transform-hub.git"
  }
}
