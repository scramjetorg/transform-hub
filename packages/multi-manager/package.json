{
  "name": "@scramjet/multi-manager",
  "version": "2.0.0",
  "description": "This package is part of Scramjet Cloud Platform.",
  "main": "src/index.ts",
  "bin": {
    "multi-manager": "src/bin/start.ts",
    "scramjet-cloud-platform-multi-manager": "src/bin/start.ts"
  },
  "scripts": {
    "start": "ts-node ./src/bin/start",
    "build": "../../scripts/build-all.js --config-name=tsconfig.build.json --copy-dist",
    "build:docker": "docker build -t ${SCRAMJET_INT_REPO_PATH}scramjetorg/multimanager:$npm_package_version -f Dockerfile ../../..",
    "clean": "rm -rf ./dist .bic_cache",
    "test": "npm run test:ava",
    "test:ava": "node ../../scripts/run-ava.js",
    "prebuild": "npm run savehash",
    "savehash": "node ../../scripts/hash-to-file.js ./src/"
  },
  "author": "Scramjet <open-source@scramjet.org>",
  "license": "MIT",
  "dependencies": {
    "@scramjet/api-router": "^2.0.0",
    "@scramjet/api-server": "^2.0.0",
    "@scramjet/api-types": "^2.0.0",
    "@scramjet/config": "^2.0.0",
    "@scramjet/load-check": "^2.0.0",
    "@scramjet/manager": "^2.0.0",
    "@scramjet/model": "^2.0.0",
    "@scramjet/monitoring-server": "^2.0.0",
    "@scramjet/obj-logger": "^2.0.0",
    "@scramjet/rest-api2": "^2.0.0",
    "@scramjet/utility": "^2.0.0",
    "@signicode/verser-common": "0.5.0",
    "@signicode/verser2-host": "0.7.0",
    "find-package-json": "^1.2.0",
    "http-status-codes": "^2.2.0",
    "rereadable-stream": "^1.4.13",
    "scramjet": "^4.37.0",
    "selfsigned": "^5.5.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@scramjet/api-types": "^2.0.0",
    "@scramjet/runtime-types": "^2.0.0",
    "@scramjet/types": "^2.0.0",
    "@types/node": "^22.15.0",
    "ava": "^3.15.0",
    "sinon": "^14.0.0",
    "trouter": "^3.2.0",
    "ts-node": "^10.9.1",
    "typescript": "^4.7.4"
  },
  "ava": {
    "extensions": [
      "ts"
    ],
    "files": [
      "**/*.spec.ts"
    ],
    "require": [
      "ts-node/register"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/scramjetorg/transform-hub.git"
  }
}
