{
  "name": "@scramjet/cli",
  "version": "2.0.0",
  "description": "This package is part of Scramjet Transform Hub. The package provides a CLI interface to communicate with Scramjet Transform Hub.",
  "main": "./src/index.ts",
  "bin": {
    "si": "./src/bin/index.ts"
  },
  "scripts": {
    "start": "ts-node ./src/bin/index",
    "start:dev": "NODE_ENV=development ts-node ./src/bin/index",
    "build": "../../scripts/build-all.js --config-name=tsconfig.build.json --copy-dist",
    "clean": "rm -rf ./dist .bic_cache",
    "cloc": "cloc src --fullpath --include-lang TypeScript --not-match-d \"(node_modules|test|dist|bdd)\" --by-percent cm",
    "test": "npm run test:ava",
    "test:ava": "node ../../scripts/run-ava.js -T 20000",
    "preinstall": "tar --version 2>&1 >/dev/null"
  },
  "author": "Scramjet <open-source@scramjet.org>",
  "license": "MIT",
  "dependencies": {
    "@scramjet/api-client": "^2.0.0",
    "@scramjet/api-router": "^2.0.0",
    "@scramjet/api-types": "^2.0.0",
    "@scramjet/client-utils": "^2.0.0",
    "@scramjet/config": "^2.0.0",
    "@scramjet/middleware-api-client": "^2.0.0",
    "@scramjet/obj-logger": "^2.0.0",
    "@scramjet/rest-api2": "^2.0.0",
    "@scramjet/utility": "^2.0.0",
    "@signicode/verser2-guest-node": "0.7.0",
    "chalk": "^4.1.2",
    "find-package-json": "^1.2.0",
    "minimatch": "^3.1.5",
    "scramjet": "^4.37.0",
    "tar": "^7.5.21",
    "validator": "^13.7.0"
  },
  "devDependencies": {
    "@ava/typescript": "^7.0.0",
    "@scramjet/runtime-types": "^2.0.0",
    "@scramjet/types": "^2.0.0",
    "@types/find-package-json": "^1.2.3",
    "@types/minimatch": "^3.0.5",
    "@types/node": "^22.15.0",
    "@types/validator": "^13.7.8",
    "ava": "^8.0.0",
    "ts-node": "^10.9.1",
    "typescript": "~4.7.4"
  },
  "assets": [
    {
      "src": "scripts/completion",
      "dest": "scripts/completion"
    }
  ],
  "ava": {
    "files": [
      "**/*.spec.ts"
    ],
    "require": [
      "ts-node/register"
    ],
    "typescript": {
      "compile": false,
      "rewritePaths": {
        "./": "../.ava-cli/"
      }
    }
  },
  "files": [
    "**/*.js",
    "**/*.d.ts",
    "**/*.json",
    "!src/**",
    "!test/**",
    "!tests/**",
    "scripts/completion",
    "!**/*.map",
    "!**/*.tsbuildinfo"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/scramjetorg/transform-hub.git",
    "directory": "packages/cli"
  }
}
